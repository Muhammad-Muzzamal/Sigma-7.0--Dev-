<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Instagram</title>
  </head>
  <body>
    <h1>ID : <%= id %></h1>
    <h1>Name : <%= name %></h1>
    <h4>Accounts that follow you :</h4>
    <ul>
      <% for(let name of follower) {%>
      <li><%= name %></li>
      <% } %>
    </ul>
  </body>
</html>
