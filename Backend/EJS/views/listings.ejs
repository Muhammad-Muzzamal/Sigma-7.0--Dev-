<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Listing</title>
  </head>
  <body style="background: rgb(36, 35, 35); color: white">
    <h1 style="text-align: center">Property Listing</h1>
    <div
      style="
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
      "
    >
      <% data.forEach((list) => { %>
      <div style="display: flex; justify-content: center; margin: 20px; border: 2px solid white; width: 800px; padding: 10px;">
        <img src="<%= list.image.url %>" alt="" style="width: 300px; margin-right:30px;" />
        <div>
          <h2><%= list.title %></h2>
          <p><%= list.description %></p>
          <p>Price: <%= list.price %></p>
          <p>Location: <%= list.location %></p>
          <p>Country: <%= list.country %></p>
          <a href="<%= list.moreInfo %>">More Info</a>
        </div>
      </div>
      <% }); %>
    </div>
  </body>
</html>
